#!/usr/bin/env bash
set -uo pipefail
# router log lines since the lab started, as JSON fields
fields() { kubectl -n f5-bnk logs deploy/switchyard-router --since=4h 2>/dev/null | grep -F "\"$1\"" | jq -c '.fields' 2>/dev/null; }
n=$(fields "pool bridge forwarded" | jq -r 'select(.pool=="small" and .pick=="epp") | .endpoint' | sort -u | wc -l)
if [ "$n" -lt 2 ]; then
  fail-message "The picker has placed small-pool requests on $n pod(s) so far. Run the burst of twelve requests again."
  exit 1
fi
exit 0
