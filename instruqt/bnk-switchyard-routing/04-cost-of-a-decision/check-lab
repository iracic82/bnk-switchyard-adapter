#!/usr/bin/env bash
set -uo pipefail
if ! jq -e 'length == 3 and all(.[]; .steps > 0 and .errors < .steps / 2) and any(.[]; .model == "auto")' /root/bench.json >/dev/null 2>&1; then
  fail-message "No finished run in /root/bench.json yet. Run the benchmark command with --json /root/bench.json and wait for the table."
  exit 1
fi
exit 0
