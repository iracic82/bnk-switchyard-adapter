#!/usr/bin/env bash
# sy: send a chat request from the lab's client container through BNK's AI gateway.
#
#   sy ask [model] "prompt"          model defaults to auto (Switchyard decides)
#   sy stream [model] "prompt"       the same, streamed
#   sy burst N [model] "prompt"      N requests in parallel: status, pod, pick, endpoint
#   sy key [eng|pilot|dynamo]        print a virtual key
#   sy logins                        the AI Gateway console login and every virtual key
#   sy threshold [0..1]              show, or set, the judge threshold of Switchyard's auto routes
#   sy judge [mock|nemotron]         show, or set, which model judges: the stand-in, or NVIDIA Nemotron
#
# The engineering key is used, or SY_KEY=pilot|dynamo; models sy-dynamo and auto-dynamo use the
# dynamo key, the one whose scope includes the Dynamo pool.
#
# auto-dynamo is not a gateway model: the AI gateway hands only `auto` to Switchyard. sy sends
# model auto with the header x-switchyard-use-route: auto-dynamo, which picks Switchyard's route.
#
# SY_SESSION=<id> sy ask "..."    one conversation: auto requests go to route auto-session with that
#                                  session ID, so the judge decides once and the session keeps the model
#
# The client sits outside the cluster, behind the fabric's router, like a real caller.
set -uo pipefail
VIP=${SY_VIP:-172.16.100.19}
KEYS=${SECRETS_DIR:-/root/.bnk}/aigw
WHO=${SY_KEY:-eng}
for a in "$@"; do case "$a" in sy-dynamo|auto-dynamo) WHO=${SY_KEY:-dynamo} ;; esac; done
key() { cat "$KEYS/switchyard-$1-key.key"; }
body() { jq -nc --arg m "$1" --arg p "$2" --argjson s "${3:-false}" '{model:$m,stream:$s,messages:[{role:"user",content:$p}]}'; }
post() { # model prompt stream
  local m=$1 route=()
  [ "$m" = auto-dynamo ] && { m=auto; route=(-H "x-switchyard-use-route: auto-dynamo"); }
  [ "$m" = auto ] && [ -n "${SY_SESSION:-}" ] && [ ${#route[@]} -eq 0 ] && \
    route=(-H "x-switchyard-use-route: auto-session" -H "x-switchyard-session-id: $SY_SESSION")
  docker exec -i client curl -s -m 120 "http://$VIP/v1/chat/completions" -D /dev/stderr "${route[@]}" \
    -H "Authorization: Bearer $(key "$WHO")" -H 'Content-Type: application/json' -d "$(body "$m" "$2" "$3")"
}
# the router's config, and applying a new one (rewrites the ConfigMap, restarts the router, waits
# until the gateway's next request goes through)
cfg_get() { kubectl -n f5-bnk get cm switchyard-router-config -o jsonpath='{.data.adapter\.toml}'; }
cfg_apply() {
  kubectl -n f5-bnk patch cm switchyard-router-config --type merge \
    -p "$(jq -n --arg v "$1" '{data:{"adapter.toml":$v}}')" >/dev/null
  kubectl -n f5-bnk rollout restart deploy/switchyard-router >/dev/null
  kubectl -n f5-bnk rollout status deploy/switchyard-router --timeout=180s >/dev/null
  for _ in $(seq 1 30); do
    [ "$(post auto "ping" false 2>&1 >/dev/null | tr -d '\r' | awk 'tolower($1) ~ /^http/ {print $2}' | tail -1)" = 200 ] && break; sleep 2
  done
}
case "${1:-}" in
  ask)
    shift; [ $# -ge 2 ] && { m=$1; shift; } || m=auto
    post "$m" "$*" false 2> >(grep -iE '^(HTTP|x-guardrail|x-switchyard|x-selected-model|x-served-by|x-pool-pick|x-pool-endpoint)' >&2) | jq -r '.model + ": " + (.choices[0].message.content // "" | .[0:160]) // .'
    ;;
  stream)
    shift; [ $# -ge 2 ] && { m=$1; shift; } || m=auto
    post "$m" "$*" true 2>/dev/null | sed -n 's/^data: //p' | head -20
    ;;
  burst)
    n=$2; shift 2; [ $# -ge 2 ] && { m=$1; shift; } || m=auto
    # one line per request: status, the pod that answered, and how the pool bridge chose it
    for _ in $(seq 1 "$n"); do
      post "$m" "$*" false 2>&1 >/dev/null | tr -d '\r' | awk '
        tolower($1) ~ /^http/ {s=$2} tolower($1)=="x-served-by:" {p=$2}
        tolower($1)=="x-pool-pick:" {k=$2} tolower($1)=="x-pool-endpoint:" {e=$2}
        END {printf "%s  %-32s %-10s %s\n", s, (p == "" ? "-" : p), k, e}' &
    done
    wait
    ;;
  key) key "${2:-eng}" ;;
  threshold)
    # Switchyard sends a step to the small model when the judge's p_solve >= the threshold.
    cur=$(cfg_get | grep -oE 'base_threshold = [0-9.]+' | head -1 | awk '{print $3}')
    if [ -z "${2:-}" ]; then echo "base_threshold = $cur"; exit 0; fi
    [[ "$2" =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] || { echo "threshold must be between 0 and 1"; exit 1; }
    cfg_apply "$(cfg_get | sed -E "s/base_threshold = [0-9.]+/base_threshold = $2/g")"
    echo "base_threshold: $cur -> $2 (the router restarted with it)"
    ;;
  judge)
    cur=$(cfg_get | grep -oE '^judge = "[a-z]+"' | head -1 | cut -d'"' -f2)
    [ "$cur" = small ] && cur=mock
    if [ -z "${2:-}" ]; then echo "judge: $cur"; exit 0; fi
    case "$2" in
      mock) to=small; deadline=3000 ;;
      nemotron)
        cfg_get | grep -q '^\[models.nemotron\]' || { echo "no Nemotron judge in this lab (needs an NVIDIA key; scripts/instruqt-judge.sh)"; exit 1; }
        to=nemotron; deadline=8000 ;;
      *) echo "judge must be mock or nemotron"; exit 1 ;;
    esac
    cfg_apply "$(cfg_get | sed -E "s/^judge = \"[a-z]+\"/judge = \"$to\"/; s/judge_deadline_ms = [0-9]+/judge_deadline_ms = $deadline/g")"
    echo "judge: $cur -> $2 (the router restarted with it)"
    ;;
  logins)
    s() { kubectl -n f5-bnk get secret f5-aigateway-admin -o jsonpath="{.data.$1}" | base64 -d; }
    echo "AI Gateway console (tab \"AI Gateway console\")"
    echo "  username: $(s username)"
    echo "  password: $(s password)"
    echo
    echo "Virtual keys (Authorization: Bearer <key>, gateway http://$VIP/v1)"
    for k in eng pilot dynamo; do [ -s "$KEYS/switchyard-$k-key.key" ] && printf '  %-7s %s\n' "$k" "$(key $k)"; done
    ;;
  *) sed -n '/^#  /p' "$0"; exit 1 ;;
esac
