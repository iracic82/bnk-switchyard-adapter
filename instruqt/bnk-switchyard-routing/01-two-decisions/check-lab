#!/usr/bin/env bash
set -uo pipefail
# router log lines since the lab started, as JSON fields
fields() { kubectl -n f5-bnk logs deploy/switchyard-router --since=4h 2>/dev/null | grep -F "\"$1\"" | jq -c '.fields' 2>/dev/null; }
routed=$(fields "ext_proc routed")
for m in small large; do
  if ! grep -q "\"selected_model\":\"$m\"" <<<"$routed"; then
    fail-message "Switchyard has not sent an 'auto' request to the $m model yet. Send the easy and the hard request again (the judge is wrong one time in ten)."
    exit 1
  fi
done
if ! fields "pool bridge forwarded" | grep -q '"pick":"epp"'; then
  fail-message "No request has reached a pod chosen by the F5 Endpoint Picker yet. Send a request with 'sy ask' and check again."
  exit 1
fi
exit 0
