#!/usr/bin/env bash
# The adapter routed 'auto' requests to both models through the external BNK Gateway.
set -uo pipefail

# Sum of a metric's samples whose labels include every given label="value" pair.
metric_sum() {
  local name=$1; shift
  kubectl get --raw /api/v1/namespaces/switchyard/services/switchyard-adapter:8080/proxy/metrics 2>/dev/null \
    | python3 -c '
import sys
name, want = sys.argv[1], sys.argv[2:]
total = 0.0
for line in sys.stdin:
    if line.startswith(name + "{") and all(w in line for w in want):
        total += float(line.rsplit(" ", 1)[1])
print(int(total))' "$name" "$@"
}

if ! kubectl -n switchyard get deploy switchyard-adapter >/dev/null 2>&1; then
  fail-message "The Switchyard adapter is not deployed. Setup may still be finishing: wait a minute and check again."
  exit 1
fi
for model in small large; do
  if [[ "$(metric_sum sy_adapter_requests_total 'route="auto"' "model=\"$model\"" 'status="ok"')" -lt 1 ]]; then
    fail-message "No successful 'auto' request has gone to the $model model yet. Run the walkthrough and the hard request again."
    exit 1
  fi
done
exit 0
