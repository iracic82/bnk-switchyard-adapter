#!/usr/bin/env bash
set -uo pipefail
code=$(docker exec client curl -s -m 60 -o /dev/null -w '%{http_code}' http://172.16.100.19/v1/chat/completions \
  -H "Authorization: Bearer $(sy key pilot)" -H 'Content-Type: application/json' \
  -d '{"model":"sy-small","messages":[{"role":"user","content":"hi"}]}')
if [ "$code" = 200 ]; then
  fail-message "The pilot key is still accepted. Run the burst loop again until requests are refused."
  exit 1
fi
exit 0
