{
 "title": "Switchyard on BNK",
 "uid": "switchyard-bnk",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "tags": [
  "switchyard",
  "bnk"
 ],
 "panels": [
  {
   "type": "row",
   "title": "Model selection (Switchyard, in the adapter)",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "timeseries",
   "title": "Requests/s by selected model",
   "id": 2,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model) (rate(sy_adapter_requests_total{model!=\"\"}[1m]))",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Decision latency",
   "id": 3,
   "description": "Time to the Switchyard routing outcome, including the judge call.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(sy_adapter_decision_seconds_bucket[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(sy_adapter_decision_seconds_bucket[1m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Routing calls/s (judge)",
   "id": 4,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model, outcome) (rate(sy_adapter_routing_calls_total[1m]))",
     "legendFormat": "{{model}} {{outcome}}"
    }
   ]
  },
  {
   "type": "row",
   "title": "Inference (through BNK to the InferencePool)",
   "id": 5,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 9
   }
  },
  {
   "type": "timeseries",
   "title": "TTFT p95 by model (streams)",
   "id": 6,
   "description": "From request arrival at the adapter, so it includes the decision.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, model) (rate(sy_adapter_ttft_seconds_bucket[1m])))",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Backend latency p95 by pool",
   "id": 7,
   "description": "Answer call until response headers.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(sy_adapter_backend_seconds_bucket[1m])))",
     "legendFormat": "{{pool}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Fallbacks and errors",
   "id": 8,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (from, to, reason) (rate(sy_adapter_fallbacks_total[1m]))",
     "legendFormat": "{{from}}>{{to}} {{reason}}"
    },
    {
     "refId": "B",
     "expr": "sum by (status) (rate(sy_adapter_requests_total{status!=\"ok\"}[1m]))",
     "legendFormat": "status {{status}}"
    }
   ]
  },
  {
   "type": "row",
   "title": "Tenants and estimated cost",
   "id": 9,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 18
   }
  },
  {
   "type": "timeseries",
   "title": "Estimated spend USD/hour by tenant and phase",
   "id": 10,
   "description": "From configured token prices. Not a GPU or token quota.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 19
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tenant, phase) (rate(sy_adapter_estimated_cost_usd_total[1m])) * 3600",
     "legendFormat": "{{tenant}} {{phase}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Output tokens/s by tenant",
   "id": 11,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 19
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tenant) (rate(sy_adapter_tokens_total{kind=\"output\",phase=\"inference\"}[1m]))",
     "legendFormat": "{{tenant}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Policy rejections/s by reason",
   "id": 12,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 19
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tenant, reason) (rate(sy_adapter_rejections_total[1m]))",
     "legendFormat": "{{tenant}} {{reason}}"
    }
   ]
  },
  {
   "type": "row",
   "title": "Pool load (reported by the model servers; SIMULATED with mock-llm)",
   "id": 13,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 27
   }
  },
  {
   "type": "timeseries",
   "title": "Running requests by pod",
   "id": 14,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 28
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pool, model_name, instance) (vllm:num_requests_running)",
     "legendFormat": "{{pool}} {{instance}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Waiting requests by pod",
   "id": 15,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 28
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pool, model_name, instance) (vllm:num_requests_waiting)",
